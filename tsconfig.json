// A:/Projeto PCA/PCA-GES-Novo/tsconfig.json
{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true, // Mantemos o noEmit aqui para o código da aplicação
    "jsx": "react-jsx", 

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* Alias Configuration */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"] 
    },
     "types": ["vite/client"] 
  },
  "include": ["src"] 
  // ✅ CORRIGIDO: Linha de 'references' removida para resolver o erro TS6310
}
