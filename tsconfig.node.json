// tsconfig.node.json (Corrigido)
{
  "compilerOptions": {
    // Configurações existentes...
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",

    /* Correções para Project References */
    "composite": true,          // ✅ ADICIONADO: Habilita o modo composite
    // "noEmit": true,          // ❌ REMOVIDO: Projeto referenciado deve poder emitir

    /* Linting (mantido) */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["vite.config.ts"] // Arquivo que este config cobre
}
