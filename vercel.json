{
  "builds": [
    { "src": "client/package.json", "use": "@vercel/static-build" },
    { "src": "api/**/*.ts", "use": "@vercel/node" }
  ],
  "installCommand": "cd client && pnpm install",
  "buildCommand": "cd client && pnpm run build",
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.ts" },
    { "src": "/(.*)", "dest": "/client/dist/$1" }
  ]
}
