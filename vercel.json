{
  "builds": [
    { 
      "src": "client/package.json", 
      "use": "@vercel/static-build"
      // "config": { "distDir": "dist" } // Boa prática manter isso explícito
    }
  ],
  "routes": [
    { "handle": "filesystem" }, 
    // ✅ CORREÇÃO: Tenta servir /index.html relativo ao diretório de saída (client/dist)
    { "src": "/(.*)", "dest": "/index.html" } 
  ]
}
